// preferences.candy — per-target library and idiom preferences for auth.
// AI codegen consumes these as hints, not requirements.
//
// Lightweight by design: SQLite + a JWT library + Argon2 for password
// hashing. Production swaps to Postgres at the database layer; the
// JWT and hash choices stay the same.

target go {
  when need database  use sqlite
  when need id        use ksuid
  when need hash      use argon2
  when need jwt       use golang-jwt
}

target rust {
  when need database  use rusqlite
  when need id        use uuid-v7
  when need hash      use argon2
  when need jwt       use jsonwebtoken
}

target typescript {
  notes: "ESM only; tagged unions over class hierarchies"
  when need database  use better-sqlite3
  when need id        use cuid2
  when need hash      use argon2
  when need jwt       use jsonwebtoken
}

target python {
  when need database  use sqlite3
  when need id        use ulid
  when need hash      use argon2-cffi
  when need jwt       use pyjwt
}
