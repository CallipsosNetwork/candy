// todo.candy — todo CRUD with three-role RBAC (admin / manager / user).
//
// Demonstrates: prose policy blocks, flow-scoped policies, role-gated
// controllers, creator_role capture, per-role delete and edit rules,
// manager assignment, inline auth (User + Session + auth flows).

prose {
  intent: """
    A todo list where what you can do depends on who you are. Three roles —
    Admin, Manager, User — govern create, edit, delete, and assign. Admins
    have full authority. Managers can create and edit todos assigned to them,
    but cannot delete. Users can create and edit their own todos and delete
    only todos they created themselves (not those created by an admin).

    Auth is inlined because each candy example is a standalone project. In a
    real multi-feature setup, User + Session + Signup/Login/Logout would live
    in a shared auth feature and be referenced via `uses:`. Here they are
    repeated so the file runs on its own.
  """

  exports:
    actor User, Session, Todo
    flow  Signup, Login, Logout, CreateTodo, UpdateTodo, ToggleTodo,
          DeleteTodo, AssignTodo, ListTodos
    event UserSignedUp, UserLoggedIn, SessionRevoked,
          TodoCreated, TodoUpdated, TodoToggled, TodoDeleted, TodoAssigned

  policies: [BearerAuth]
}

// ─── Shared primitives ────────────────────────────────────────────────────────

type Id           opaque  { max: 64 }
type Timestamp    instant { tz: utc }
type Email        string  { max: 320, format: rfc5322 }
type Password     string  { intent: "Plaintext at rest is forbidden — only hashed forms persist." }
type PasswordHash opaque
type Token        opaque  { max: 256 }
type Key          opaque  { max: 128 }

enum Role { Admin, Manager, User }

enum TodoStatus { Open, Done }

// ListFilter controls which todos a caller fetches.
// Controller enforces role-scoped limits on which values each role may use.
enum ListFilter { All, MineOnly, AssignedToMe }

// ─── Actors ───────────────────────────────────────────────────────────────────

actor User(id: Id) {
  state {
    email:    Email
    hash:     PasswordHash
    role:     Role      = User
    verified: bool      = false
    created:  Timestamp
  }

  invariant "email is unique across all User instances"

  accepts Verify() -> Result<unit, AlreadyVerified> {
    intent: "Mark the user's email as verified."
    require: verified == false  rescue reject AlreadyVerified
    effect: verified = true
    emit UserVerified { user: self.id, at: now }
    commit
  }

  // Valid promotions: any role -> any role except demoting Admin -> User.
  // The controller layer gates this behind RoleGated(Admin), so only an
  // admin can call it — but the actor still guards the transition itself.
  accepts Promote(to: Role) -> Result<unit, InvalidPromotion> {
    intent: "Change a user's role. Rejects Admin → User demotions."
    require: not (role == Admin and to == User)  rescue reject InvalidPromotion
    effect: role = to
    commit
  }
}

actor Session(token: Token) {
  state {
    user:    Id
    role:    Role
    issued:  Timestamp
    expires: Timestamp = now after 7d
    revoked: bool      = false
  }

  invariant "expires > issued"

  accepts Validate(now: Timestamp) -> Result<{ user: Id, role: Role }, SessionInvalid> {
    intent: "Return user id and role if the session is live; reject otherwise."
    require: revoked == false  rescue reject SessionInvalid
    require: now < expires     rescue reject SessionInvalid
    commit { user: self.user, role: self.role }
  }

  accepts Revoke() -> unit {
    intent: "Mark the session as revoked. Idempotent — re-revoking is a no-op."
    effect: revoked = true
    emit SessionRevoked { token: self.token, user: self.user, at: now }
    commit
  }
}

actor Todo(id: Id) {
  state {
    text:         string
    done:         bool      = false
    owner:        Id        // user who created the todo
    creator_role: Role      // role of the creator at time of creation
    assigned_to:  Id?       // optional manager assignment
    created:      Timestamp
    updated:      Timestamp
  }

  // creator_role is captured at creation time so CanDeleteTodo can enforce
  // "user cannot delete admin-created todos" without re-fetching the creator.
  // If the creator's role later changes that does not retroactively unprotect
  // their todos — the protection is about the authority level when the todo
  // was made, not the current authority of the creator.

  invariant length(text) > 0
  invariant "creator_role is one of Admin, Manager, User"
  invariant "when assigned_to is set, the referenced user has role Manager"

  accepts Update(text: string, now: Timestamp) -> Result<unit, EmptyText> {
    intent: "Replace the todo's text. Called by flows after policy checks pass."
    require: length(text) > 0  rescue reject EmptyText
    effect: self.text = text
    effect: updated = now
    emit TodoUpdated { todo: self.id, owner, text, at: now }
    commit
  }

  accepts Toggle(now: Timestamp) -> unit {
    intent: "Flip the done flag."
    effect: done = not done
    effect: updated = now
    emit TodoToggled { todo: self.id, owner, done, at: now }
    commit
  }

  accepts Assign(manager: Id, now: Timestamp) -> unit {
    intent: "Set the assigned_to field. Precondition (manager role) checked by AssignTodo flow."
    effect: assigned_to = manager
    effect: updated = now
    emit TodoAssigned { todo: self.id, owner, manager, at: now }
    commit
  }

  accepts MarkDeleted(now: Timestamp) -> unit {
    intent: "Remove this todo. Called by DeleteTodo after CanDeleteTodo passes."
    effect: Todo(self.id).delete()
    emit TodoDeleted { todo: self.id, owner, at: now }
    commit
  }
}

// ─── Policies ─────────────────────────────────────────────────────────────────

policy PasswordStrength {
  intent: """
    A password is acceptable when:
      - length >= 12
      - contains at least one letter and one digit
      - is not in the common-password blocklist

    Hashing uses argon2id with parameters from deployment secrets.
    Plaintext passwords never persist; only PasswordHash is stored.
  """
  examples:
    - given: "correct horse battery staple 9"
      then:  ok
    - given: "short1"
      then:  err(TooShort)
    - given: "alllowercase"
      then:  err(MissingDigit)
    - given: "password123"
      then:  err(InBlocklist)
}

policy BearerAuth {
  intent: """
    Validates the Authorization: Bearer <token> header on every request.
    Calls Session(token).Validate(now) and binds the returned user id and
    role into session.user and session.role for downstream policy checks.
    Signup and Login override this at route scope with auth: none because
    callers have no session yet.

    On missing or invalid token the request is rejected with 401.
    On expired or revoked session the request is rejected with 401.
  """
  examples:
    - given: "valid unexpired token for user with role Admin"
      then:  ok({ user: <id>, role: Admin })
    - given: "valid unexpired token for user with role Manager"
      then:  ok({ user: <id>, role: Manager })
    - given: "valid unexpired token for user with role User"
      then:  ok({ user: <id>, role: User })
    - given: "expired token"
      then:  err(SessionInvalid)
    - given: "missing Authorization header"
      then:  err(Unauthenticated)
}

// RoleGated is parameterized at the attachment site: policies: [RoleGated(Admin)]
// The required role is the *minimum* level needed. Role hierarchy: User < Manager < Admin.
// A caller at or above the required level proceeds; below it is rejected with 403.
policy RoleGated {
  intent: """
    Compares the session-bound role against the required minimum. The role
    hierarchy is User < Manager < Admin. A caller whose role is below the
    required level receives NotAuthorized; equal or higher proceeds.

    The required role is supplied as a parameter at the attachment site.
    BearerAuth runs first (feature-scope) to establish the session; RoleGated
    then inspects session.role.
  """
  examples:
    - given: "required Admin, caller role Admin"
      then:  ok
    - given: "required Admin, caller role Manager"
      then:  err(NotAuthorized)
    - given: "required Admin, caller role User"
      then:  err(NotAuthorized)
    - given: "required Manager, caller role Admin"
      then:  ok
    - given: "required Manager, caller role Manager"
      then:  ok
    - given: "required Manager, caller role User"
      then:  err(NotAuthorized)
    - given: "required User, caller role Admin"
      then:  ok
    - given: "required User, caller role Manager"
      then:  ok
    - given: "required User, caller role User"
      then:  ok
}

// CanEditTodo governs UpdateTodo and ToggleTodo.
// Three parties may edit a todo: its owner, any admin, or a manager assigned to it.
policy CanEditTodo {
  intent: """
    A todo may be edited when at least one of these holds:

      1. The caller is the todo's owner (the user who created it).
         Owner-edit applies regardless of the caller's role.
      2. The caller's role is Admin. Admins may edit any todo unconditionally.
      3. The caller's role is Manager AND the todo's assigned_to equals the
         caller's user id — i.e. the manager has been explicitly assigned.

    A manager who has not been assigned to a given todo cannot edit it, even
    if they are assigned to other todos. Assignment is per-todo, not per-user.

    A plain User who is not the owner cannot edit, even if they are somehow
    listed on the todo (there is no other listing mechanism in this spec).
  """
  examples:
    - given: >
        caller user U1 (role User), todo.owner = U1
      then:  ok

    - given: >
        caller user A1 (role Admin), todo.owner = U1 (A1 != U1)
      then:  ok

    - given: >
        caller user M1 (role Manager), todo.owner = U1,
        todo.assigned_to = M1
      then:  ok

    - given: >
        caller user M2 (role Manager), todo.owner = U1,
        todo.assigned_to = M1 (M2 != M1)
      then:  err(NotAuthorized)

    - given: >
        caller user U2 (role User), todo.owner = U1 (U2 != U1)
      then:  err(NotAuthorized)

    - given: >
        caller user M1 (role Manager), todo.owner = U1,
        todo.assigned_to = null (no manager assigned)
      then:  err(NotAuthorized)
}

// CanDeleteTodo governs DeleteTodo.
// Admins can delete anything. Users can delete their own todos unless an admin
// created them. Managers can never delete, regardless of assignment.
policy CanDeleteTodo {
  intent: """
    A todo may be deleted when:

      - The caller's role is Admin. Admins may delete any todo.
      - OR: the caller is the todo's owner AND the todo's creator_role is not
        Admin — meaning the owner created it as a Manager or User and retains
        delete rights over it.

    A user who owns a todo originally created by an admin cannot delete it.
    Managers cannot delete any todo regardless of ownership or assignment.
    The rule is intentionally asymmetric: create authority (admin-created)
    raises the protection level on a todo for its lifetime.
  """
  examples:
    - given: >
        caller user A1 (role Admin), todo.owner = U1 (A1 != U1)
      then:  ok

    - given: >
        caller user U1 (role User), todo.owner = U1,
        todo.creator_role = User
      then:  ok

    - given: >
        caller user U1 (role User), todo.owner = U1,
        todo.creator_role = Admin
      then:  err(NotAuthorized)

    - given: >
        caller user M1 (role Manager), todo.owner = M1,
        todo.creator_role = Manager
      then:  err(NotAuthorized)

    - given: >
        caller user U2 (role User), todo.owner = U1 (U2 != U1),
        todo.creator_role = User
      then:  err(NotAuthorized)

    - given: >
        caller user A1 (role Admin), todo.owner = A1,
        todo.creator_role = Admin
      then:  ok
}

// CanAssignTodo governs AssignTodo. Admin-only.
policy CanAssignTodo {
  intent: """
    Only admins may assign a todo to a manager. Managers cannot self-assign
    or assign others' todos. Users cannot assign at all. This policy is
    redundant with RoleGated(Admin) on the route but is declared explicitly
    so the permission is visible at flow scope in addition to route scope.
  """
  examples:
    - given: "caller role Admin"
      then:  ok
    - given: "caller role Manager"
      then:  err(NotAuthorized)
    - given: "caller role User"
      then:  err(NotAuthorized)
}

// ─── Auth flows ───────────────────────────────────────────────────────────────

flow Signup(email: Email, password: Password, now: Timestamp, key: Key)
  -> Result<{ user: Id, token: Token }, WeakPassword | EmailTaken>
{
  intent: """
    Create a new User account with role User, hash the password, and issue
    an initial session. Idempotent on key — replaying with the same key
    returns the same user id and a fresh token without creating duplicates.
  """

  step strength = PasswordStrength(password)
                  rescue reject WeakPassword(reason)

  step taken    = if any u in User where u.email == email
                  then reject EmailTaken

  step user     = ask User.create({
                    id:      generate(),
                    email,
                    hash:    hash(password),
                    role:    User,
                    created: now,
                  })

  step session  = ask Session.create({
                    token:   generate(),
                    user:    user.id,
                    role:    User,
                    issued:  now,
                    expires: now after 7d,
                  })

  emit UserSignedUp { user: user.id, email, at: now }
  commit { user: user.id, token: session.token }
}

flow Login(email: Email, password: Password, now: Timestamp, key: Key)
  -> Result<{ user: Id, role: Role, token: Token }, InvalidCredentials>
{
  intent: """
    Authenticate by email and password. Issues a new session carrying the
    user's current role so the JWT payload includes it. Errors are opaque —
    never reveal which of email or password was wrong.
  """

  step user    = ask User.findBy(email)                        rescue reject InvalidCredentials
  step ok      = if not verify(password, user.hash) then reject InvalidCredentials
  step session = ask Session.create({
                   token:   generate(),
                   user:    user.id,
                   role:    user.role,
                   issued:  now,
                   expires: now after 7d,
                 })

  emit UserLoggedIn { user: user.id, at: now }
  commit { user: user.id, role: user.role, token: session.token }
}

flow Logout(token: Token, now: Timestamp, key: Key) -> unit {
  intent: "Revoke the session associated with the given bearer token. Idempotent."
  step _ = ask Session(token).Revoke()
  commit
}

// ─── Todo flows ───────────────────────────────────────────────────────────────

flow CreateTodo(text: string, now: Timestamp, key: Key)
  -> Result<{ todo: Id }, EmptyText>
{
  intent: """
    Create a new todo owned by the authenticated caller. The caller's role
    is captured as creator_role at creation time — this value drives
    CanDeleteTodo for the lifetime of the todo and cannot be retroactively
    changed. Any authenticated user may create a todo regardless of role.
  """

  step empty = if length(text) == 0 then reject EmptyText

  step todo  = ask Todo.create({
                 id:           generate(),
                 text,
                 done:         false,
                 owner:        session.user,
                 creator_role: session.role,
                 assigned_to:  null,
                 created:      now,
                 updated:      now,
               })

  emit TodoCreated { todo: todo.id, owner: session.user, creator_role: session.role, at: now }
  commit { todo: todo.id }
}

flow UpdateTodo(todo: Id, text: string, now: Timestamp, key: Key)
  -> Result<unit, NotAuthorized | TodoNotFound | EmptyText>
{
  intent: """
    Replace the text of an existing todo. Governed by CanEditTodo: the caller
    must be the owner, an admin, or a manager assigned to this specific todo.
  """

  policies: [CanEditTodo]

  step t    = ask Todo.findBy(id: todo)  rescue reject TodoNotFound
  step _    = ask Todo(todo).Update(text, now)
              rescue reject err
  commit
}

flow ToggleTodo(todo: Id, now: Timestamp, key: Key)
  -> Result<{ done: bool }, NotAuthorized | TodoNotFound>
{
  intent: """
    Flip the done flag on a todo. Governed by CanEditTodo — same edit
    permission applies to toggling as to text edits.
  """

  policies: [CanEditTodo]

  step t = ask Todo.findBy(id: todo)  rescue reject TodoNotFound
  step _ = ask Todo(todo).Toggle(now)
  commit { done: not t.done }
}

flow DeleteTodo(todo: Id, now: Timestamp, key: Key)
  -> Result<unit, NotAuthorized | TodoNotFound>
{
  intent: """
    Delete a todo. Governed by CanDeleteTodo: admins may delete anything;
    users may delete only their own todos when creator_role != Admin;
    managers cannot delete.
  """

  policies: [CanDeleteTodo]

  step t = ask Todo.findBy(id: todo)  rescue reject TodoNotFound
  step _ = ask Todo(todo).MarkDeleted(now)
  commit
}

flow AssignTodo(todo: Id, manager: Id, now: Timestamp, key: Key)
  -> Result<unit, NotAuthorized | TodoNotFound | UserNotFound | NotManager>
{
  intent: """
    Assign a todo to a manager. Only admins may call this (CanAssignTodo +
    RoleGated(Admin) on the route). Verifies the assignee actually holds the
    Manager role — assigning to a User or Admin is rejected with NotManager.
  """

  policies: [CanAssignTodo]

  step t = ask Todo.findBy(id: todo)       rescue reject TodoNotFound
  step m = ask User.findBy(id: manager)    rescue reject UserNotFound
  step _ = if m.role != Manager then reject NotManager
  step _ = ask Todo(todo).Assign(manager, now)
  commit
}

flow ListTodos(filter: ListFilter, now: Timestamp)
  -> Result<{ todos: [Todo] }, NotAuthorized>
{
  intent: """
    Return todos according to the filter. The controller enforces which
    filters each role may use: Admin may pass All; Manager and User may only
    pass MineOnly or AssignedToMe. If a non-admin caller passes All the flow
    rejects with NotAuthorized.

    MineOnly returns todos where owner == session.user.
    AssignedToMe returns todos where assigned_to == session.user (Manager only).
    All returns every todo (Admin only).
  """

  step _ = if filter == All and session.role != Admin
           then reject NotAuthorized

  step todos = if filter == All
               then     all t in Todo
               else if filter == MineOnly
               then     all t in Todo where t.owner == session.user
               else     all t in Todo where t.assigned_to == session.user

  commit { todos }
}

// ─── Events ───────────────────────────────────────────────────────────────────

event UserSignedUp  { payload: { user: Id, email: Email, at: Timestamp },             delivery: eager }
event UserLoggedIn  { payload: { user: Id, at: Timestamp },                           delivery: eager, order: by user }
event UserVerified  { payload: { user: Id, at: Timestamp },                           delivery: eager }
event SessionRevoked { payload: { token: Token, user: Id, at: Timestamp },            delivery: eager }

event TodoCreated   { payload: { todo: Id, owner: Id, creator_role: Role, at: Timestamp }, delivery: eager }
event TodoUpdated   { payload: { todo: Id, owner: Id, text: string, at: Timestamp },       delivery: eager }
event TodoToggled   { payload: { todo: Id, owner: Id, done: bool, at: Timestamp },         delivery: eager }
event TodoDeleted   { payload: { todo: Id, owner: Id, at: Timestamp },                     delivery: eager }
event TodoAssigned  { payload: { todo: Id, owner: Id, manager: Id, at: Timestamp },        delivery: eager }

// ─── Controller ───────────────────────────────────────────────────────────────

controller Todos {

  // Auth — no BearerAuth on these two; callers have no session yet.

  POST /signup -> Signup(email, password, now, idempotency_key) {
    auth: none
    body: { email: Email, password: Password, idempotency_key: Key }
    map:
      ok(result)               -> 201 { user_id: result.user, token: result.token }
      err(WeakPassword reason) -> 422 { error: "weak_password", reason }
      err(EmailTaken)          -> 409 { error: "email_taken" }
  }

  POST /login -> Login(email, password, now, idempotency_key) {
    auth: none
    body: { email: Email, password: Password, idempotency_key: Key }
    map:
      ok(result)              -> 200 { user_id: result.user, role: result.role, token: result.token }
      err(InvalidCredentials) -> 401 { error: "invalid_credentials" }
  }

  POST /logout -> Logout(bearer, now, idempotency_key) {
    auth: bearer
    body: { idempotency_key: Key }
    map:
      ok(_) -> 204
  }

  // Admin — promote a user's role. RoleGated(Admin) added per-route.

  POST /admin/users/:id/promote -> User(id).Promote(role) {
    auth: bearer
    policies: [RoleGated(Admin)]
    body: { role: Role }
    map:
      ok(_)                 -> 200 { promoted: true }
      err(InvalidPromotion) -> 422 { error: "invalid_promotion" }
  }

  // Todos — all authenticated. BearerAuth runs at feature scope.

  POST /todos -> CreateTodo(text, now, idempotency_key) {
    auth: bearer
    body: { text: string, idempotency_key: Key }
    map:
      ok(result)     -> 201 { todo_id: result.todo }
      err(EmptyText) -> 422 { error: "empty_text" }
  }

  PATCH /todos/:id -> UpdateTodo(id, text, now, idempotency_key) {
    auth: bearer
    body: { text: string, idempotency_key: Key }
    map:
      ok(_)               -> 200
      err(NotAuthorized)  -> 403 { error: "not_authorized" }
      err(TodoNotFound)   -> 404 { error: "not_found" }
      err(EmptyText)      -> 422 { error: "empty_text" }
  }

  POST /todos/:id/toggle -> ToggleTodo(id, now, idempotency_key) {
    auth: bearer
    body: { idempotency_key: Key }
    map:
      ok(result)          -> 200 { done: result.done }
      err(NotAuthorized)  -> 403 { error: "not_authorized" }
      err(TodoNotFound)   -> 404 { error: "not_found" }
  }

  DELETE /todos/:id -> DeleteTodo(id, now, idempotency_key) {
    auth: bearer
    body: { idempotency_key: Key }
    map:
      ok(_)               -> 204
      err(NotAuthorized)  -> 403 { error: "not_authorized" }
      err(TodoNotFound)   -> 404 { error: "not_found" }
  }

  // Assign — admin-only. RoleGated(Admin) on top of BearerAuth.

  POST /admin/todos/:id/assign -> AssignTodo(id, manager, now, idempotency_key) {
    auth: bearer
    policies: [RoleGated(Admin)]
    body: { manager: Id, idempotency_key: Key }
    map:
      ok(_)              -> 200 { assigned: true }
      err(TodoNotFound)  -> 404 { error: "todo_not_found" }
      err(UserNotFound)  -> 404 { error: "user_not_found" }
      err(NotManager)    -> 422 { error: "not_a_manager" }
      err(NotAuthorized) -> 403 { error: "not_authorized" }
  }

  // List — filter scoping enforced inside the flow.

  GET /todos -> ListTodos(filter, now) {
    auth: bearer
    map:
      ok(result)         -> 200 { todos: result.todos }
      err(NotAuthorized) -> 403 { error: "not_authorized" }
  }
}
