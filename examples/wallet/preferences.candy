// preferences.candy — per-target library and idiom preferences for wallet.
// AI codegen consumes these as hints, not requirements.
//
// Lightweight by design: SQLite + a JWT library + Argon2 for password hashing.
// No external payment SDKs, no queue. The schedule runtime is provided by the
// codegen target's own scheduler (cron, tokio interval, APScheduler, etc.).
// Production swaps to Postgres at the database layer; JWT and hash choices stay.

target go {
  when need database   use sqlite
  when need id         use ksuid
  when need hash       use argon2
  when need jwt        use golang-jwt
  when need scheduler  use gocron
}

target rust {
  when need database   use rusqlite
  when need id         use uuid-v7
  when need hash       use argon2
  when need jwt        use jsonwebtoken
  when need scheduler  use tokio-cron-scheduler
}

target typescript {
  notes: "ESM only; tagged unions over class hierarchies; bigint for Money"
  when need database   use better-sqlite3
  when need id         use cuid2
  when need hash       use argon2
  when need jwt        use jsonwebtoken
  when need scheduler  use node-cron
}

target python {
  when need database   use sqlite3
  when need id         use ulid
  when need hash       use argon2-cffi
  when need jwt        use pyjwt
  when need scheduler  use apscheduler
}
