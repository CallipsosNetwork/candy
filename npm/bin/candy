#!/usr/bin/env node
// bin/candy — shim that exec's the downloaded native binary
'use strict';

const path = require('path');
const fs = require('fs');
const { execFileSync } = require('child_process');

const binName = process.platform === 'win32' ? 'candy.exe' : 'candy-bin';
const binPath = path.join(__dirname, binName);

if (!fs.existsSync(binPath)) {
  console.error(
    `[candy] Binary not found at ${binPath}.\n` +
    `Run \`npm install\` again or build from source: cargo install candy`
  );
  process.exit(1);
}

try {
  execFileSync(binPath, process.argv.slice(2), { stdio: 'inherit' });
} catch (e) {
  process.exit(e.status ?? 1);
}
